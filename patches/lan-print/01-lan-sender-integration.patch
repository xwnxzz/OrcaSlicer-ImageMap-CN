+static std::string ft_abi_status_str()
+{
+    try {
+        const FileTransferModule &m = module();
+        const std::string ver = std::to_string(m.plugin_abi());
+        std::string out = m.abi_ok() ? "true" : "false";
+        out += "(plugin=";
+        out += ver;
+        out += ")";
+        return out;
+    } catch (...) {
+        return "unavailable";
+    }
+}
